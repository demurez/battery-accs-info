[Version]
Signature="$Windows NT$"
Class=Extension
ClassGuid={e2f84ce7-8efa-411c-aa69-97454ca4cb57}
ExtensionId={d15c182e-1c2e-43c3-a8ed-1818491bc430}
Provider=%Provider%
CatalogFile=PeripheralChargeDirewolf.cat
DriverVer=11/21/2026,0.1.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%Model%=Install,USB\VID_045E&PID_028E&REV_0104

[Install.NT]
CopyFiles=FilterFiles

[Install.NT.Services]
AddService=PeripheralChargeDirewolf,,FilterService

[Install.NT.Filters]
AddFilter=PeripheralChargeDirewolf,,BatteryFilter

[BatteryFilter]
FilterPosition=Lower

[Install.NT.Wdf]
KmdfService=PeripheralChargeDirewolf,FilterWdf

[FilterWdf]
KmdfLibraryVersion=1.33

[FilterService]
DisplayName=%Model%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\PeripheralChargeDirewolf.sys

[DestinationDirs]
FilterFiles=13

[FilterFiles]
PeripheralChargeDirewolf.sys

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
PeripheralChargeDirewolf.sys=1

[Strings]
Provider="Battery Monitor"
Model="Direwolf 4 battery USB filter"
Disk="Battery Monitor driver package"
